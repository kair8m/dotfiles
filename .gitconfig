[include]
	path = /Users/kairzhanmuldashev/.config/delta/catppuccin.gitconfig
[core]
    pager = delta --syntax-theme Catppuccin-frappe
    excludesfile = /Users/kairzhanmuldashev/.gitignore

[interactive]
    diffFilter = delta --color-only --syntax-theme Catppuccin-frappe
[add.interactive]
    useBuiltin = false # required for git 2.37.0

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	; side-by-side = true
	line-numbers = true
	features = catppuccin-frappe

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
[user]
	name = Kairzhan Muldashev
	email = kmuldashev@fyusion.com
[rebase]
	autoStash = true
